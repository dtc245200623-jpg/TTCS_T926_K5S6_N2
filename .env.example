# ===================================================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG DỰ ÁN (.env.example)
# ===================================================================
# HƯỚNG DẪN DÀNH CHO THÀNH VIÊN TRONG NHÓM:
# 1. Tạo một bản sao của file này và đổi tên thành '.env'
#    (Ví dụ trên Terminal: cp .env.example .env hoặc tạo thủ công)
# 2. Điền thông tin kết nối SQL Server chung (hoặc máy chủ của bạn) vào file .env
# 3. File .env đã được cấu hình trong .gitignore, sẽ KHÔNG bị đẩy lên GitHub.
# ===================================================================

# 1. Cấu hình kết nối SQL Server chung
# - Nếu dùng SQL Server chung qua mạng/IP: ví dụ 123.45.67.89,1433 hoặc 192.168.1.50,1433
# - Nếu dùng SQL Server cục bộ trên máy: localhost\SQLEXPRESS02 hoặc localhost:1433
DB_SERVER=localhost\SQLEXPRESS02
DB_NAME=TTCS_T926_K5S6_N2
DB_USER=sa
DB_PASSWORD=123

# (Tùy chọn) Chuỗi kết nối JDBC trực tiếp nếu muốn chỉ định rõ toàn bộ URL:
# DB_URL=jdbc:sqlserver://localhost\SQLEXPRESS02;databaseName=TTCS_T926_K5S6_N2;encrypt=true;trustServerCertificate=true

# 2. Cổng chạy Backend (mặc định 8080)
SERVER_PORT=8080

# 3. Cấu hình dịch vụ Email (Gmail SMTP để gửi mã OTP, thông báo tuyển dụng)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=dtc245200623@ictu.edu.vn
MAIL_PASSWORD=syykmjwlzwekgovs

# 4. Cấu hình bảo mật JWT Token
JWT_SECRET=mySecretKeyForJwtSigningMustBeVeryLongAndSecure12345678
JWT_EXPIRATION_MS=86400000
